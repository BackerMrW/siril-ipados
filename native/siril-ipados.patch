diff --git a/meson.build b/meson.build
index 417eaf8..5dd2661 100644
--- a/meson.build
+++ b/meson.build
@@ -50,6 +50,10 @@ have_fftw3fthreadsnolinkerarg = false
 #   - true  → builds the GTK4 GUI from src/gui-gtk4 (default).
 #   - false → headless CLI-only build (no GTK / GtkSourceView / X11 deps).
 enable_gtk       = get_option('gtk')
+enable_embedded  = get_option('embedded')
+if enable_embedded and enable_gtk
+  error('Embedded builds require -Dgtk=false')
+endif
 gui_subdir       = 'gui-gtk4'
 if enable_gtk
   add_project_arguments('-DUSE_GTK4=1', language: ['c', 'cpp'])
@@ -109,6 +113,13 @@ endif
 
 host_cpu_family = host_machine.cpu_family()
 host_os = host_machine.system().to_lower()
+platform_ios = meson.get_external_property('siril_apple_mobile', false)
+if platform_ios and (host_os != 'darwin' or not enable_embedded)
+  error('Apple mobile builds require Darwin cross configuration and -Dembedded=true')
+endif
+if platform_ios and (enable_openmp or get_option('arch_native'))
+  error('Apple mobile baseline requires -Dopenmp=false -Darch_native=false')
+endif
 message('Host os: ' + host_os)
 
 platform_linux = (
@@ -192,7 +203,10 @@ elif platform_windows
   siril_cpp_flag += ['-D_WIN32_WINNT=0x0600', '-DWINVER=0x0600']
 elif platform_osx
   # on OSX ObjC and C sources are mixed so adding objc to the linkflags
-  siril_link_arg += ['-Wl,-framework,Foundation', '-Wl,-framework,AppKit', '-Wl,-framework,Security', '-ObjC']
+  siril_link_arg += ['-Wl,-framework,Foundation', '-Wl,-framework,Security', '-ObjC']
+  if not platform_ios
+    siril_link_arg += '-Wl,-framework,AppKit'
+  endif
   add_project_arguments('-ObjC', language: [ 'c'])
   add_project_link_arguments(siril_link_arg, language: [ 'c', 'cpp' ])
 else
@@ -540,6 +554,7 @@ conf_data.set('SIRIL_UNSTABLE', stable ? false : 1)
 conf_data.set('SIRIL_OUTPUT_DEBUG', get_option('buildtype').startswith('debug') ? 1 : false)
 conf_data.set('ENABLE_RELOCATABLE_RESOURCES', relocatable_bundle ? 1 : false)
 conf_data.set('OS_OSX', platform_osx ? 1 : false)
+conf_data.set('OS_IOS', platform_ios ? 1 : false)
 conf_data.set('HAVE_GTK', enable_gtk ? 1 : false, description : 'Build includes GTK GUI support.')
 conf_data.set('HAVE_X11_DND_FALLBACK', enable_x11_dnd_fallback ? 1 : false, description : 'GTK4 X11 drag-and-drop fallback compiled in (libX11 linked).')
 
